# API-Football (api-sports.io / api-football.com) のAPIキーをここに設定してください。
# 取得方法: https://dashboard.api-football.com/register で無料アカウント登録 →
#          ダッシュボードの「My Access」に表示されるキーをコピー。
# 無料プラン(100リクエスト/日)でも動作確認は可能です。本番運用や選手数を増やす場合は
# Pro($19/月・7,500req/日)以上への切り替えを推奨します。
API_FOOTBALL_KEY=your_api_key_here

# RapidAPI経由でキーを取得した場合は下を true にしてください(認証ヘッダーが変わります)。
API_FOOTBALL_VIA_RAPIDAPI=false

# サーバーのポート番号
PORT=8787

# 「今日の試合」で対象にするリーグID(カンマ区切り)。デフォルトは登録選手の主要リーグ。
# 39=プレミアリーグ, 140=ラ・リーガ, 78=ブンデスリーガ, 135=セリエA, 61=リーグ・アン
DEFAULT_LEAGUES=39,140,78,135,61

# 選手検索(/api/player-season-stats)で順番に試すリーグID(カンマ区切り)。
# API-Footballの/playersはsearchだけでは呼び出せず、league(またはteam)が必須なため、
# ここに登録したリーグを順番に試して選手を探します。既定値はDEFAULT_LEAGUESに加えて
# MLS(253)・サウジ・プロリーグ(307、いずれも推測値)を含みます。登録選手が見つからない
# 場合は、その選手の所属リーグのIDを調べて追加してください。
# SEARCH_LEAGUES=39,140,78,135,61,253,307

# ---- AI予測の「本物の正答率」を記録するためのUpstash Redis(任意・無料) ----
# ここを設定しなくてもアプリは普通に動きます(ホーム画面の「AI予測の実績」欄が
# 「これから記録を開始します」という表示のままになるだけです)。
# 設定すると、試合前にAI(API-Footballの実際の予測データ)が出した予測と、実際の
# 試合結果を本当に記録・検証し、架空ではない本物の的中率をホーム画面に表示できます。
#
# 取得方法(クレジットカード不要・1分程度):
# 1. https://console.upstash.com/ にアクセスし、無料アカウントを作成
#    (Email / GitHub / Google のいずれかでサインアップ可能)
# 2. ログイン後「Create Database」→ 名前を適当に付けて(例: soccer-ai)作成
#    (Type は「Regional」、リージョンは近い場所でOK。無料プランのままで十分です)
# 3. 作成したデータベースの画面を開き、「REST API」という項目までスクロール
# 4. 「UPSTASH_REDIS_REST_URL」と「UPSTASH_REDIS_REST_TOKEN」という2つの値が
#    表示されるので、それぞれ下にコピーしてください
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- 自動収集エンドポイント(/api/predictions/auto-collect)の保護用キー(任意) ----
# 設定すると、?key=ここで設定した文字列 が一致した場合のみこのエンドポイントが
# 動作するようになる(悪意ある連打でAPI-Footballの無料枠を消費されるのを防ぐ)。
# 未設定の場合は誰でも呼び出せてしまうので、外部cronサービスから定期実行する
# 場合は、好きな英数字の文字列を設定しておくことを推奨します。
# Stage D「毎日学習エンジン」(/api/learning/run-daily)の保護にも同じ値を流用します
# (新しいシークレットを別途設定する必要はありません)。
AUTO_COLLECT_SECRET=

# ---- Stage C: 対話エンジン(議論モード)用のLLM設定 ----
# 「〜だと思う」「なぜ？」のような意見・考察を求める質問に、AIが実データを根拠に
# 考察を返す機能です。設定しなくてもアプリ全体は問題なく動作します(この機能だけが
# 「LLMのAPIキーが設定されていません」という正直な表示になります)。
#
# LLM_PROVIDER: どのAI会社のモデルを使うか。既定値は anthropic です。
# 将来ここを openai / gemini / openrouter / local に変更するだけで、コードを一切
# 変更せずにモデルを乗り換えられます(ただし現時点でフル実装されているのは
# anthropic のみです。他の値は server/llm/providers/ にプレースホルダーがあり、
# 実装が済むまでは「まだ実装されていません」というエラーになります)。
LLM_PROVIDER=anthropic

# Anthropic(Claude)のAPIキー。取得方法(クレジットカードの登録が必要です):
# 1. https://console.anthropic.com/ にアクセスし、アカウントを作成
# 2. 左メニューの「API Keys」→「Create Key」でキーを発行してコピー
# 3. 支払い方法の登録(従量課金。使った分だけ請求されます。詳しくは
#    server/README.mdの「AI対話エンジン(議論モード)について」を参照)
ANTHROPIC_API_KEY=

# 使用するモデルID(既定値は低コストな軽量モデル claude-haiku-4-5。2026年8月時点で
# 入力$1/出力$5(共に100万トークンあたり)。最新の推奨モデルIDと料金は
# https://platform.claude.com/docs/en/about-claude/models で確認してください。
# ANTHROPIC_MODEL=claude-haiku-4-5

# ---- LLM呼び出しの上限(コストの暴走を防ぐための安全装置。2段階) ----
# 世界中の誰でも使える公開サービスを想定し、①利用者(IP)ごとの1日あたり上限と、
# ②サイト全体の1日あたり上限、の2つを組み合わせている。①だけだと悪意ある
# アクセスがIPを分散させた場合に対応できず、②だけだと一人(または一箇所からの
# 大量アクセス)がその日の枠を独り占めして他の利用者が誰も使えなくなるため。

# 利用者(IPアドレス)ごとの1日あたりの上限。デフォルト10回。
PER_IP_LLM_CALLS_PER_DAY=10

# サイト全体での1日あたりの上限(最後の安全弁)。デフォルト2000回。
# 例: Claude Haiku 4.5(既定モデル)で1日2000回をすべて使い切っても、
# 実費はだいたい数百円〜1,000円程度(1回あたり0.3〜0.5円が目安)。
# この回数を超えると、正直に「利用が集中しているため一時的に制限しています」と
# 表示され、それ以上はLLMを呼び出しません(＝それ以上の課金は発生しません)。
MAX_LLM_CALLS_PER_DAY=2000

# ---- さらに安心したい場合(強く推奨) ----
# 上記2つはあくまでこのアプリのコード側の安全装置です。コードのバグや
# 想定外の抜け道があった場合の「最後の砦」として、Anthropic Console
# (https://platform.claude.com/ → 組織の設定 → 請求)側でも「使用量上限」を
# 別途設定しておくことを強く推奨します。これを設定しておけば、アプリ側の
# 仕組みが万が一機能しなくても、設定した金額以上は絶対に請求されません。
